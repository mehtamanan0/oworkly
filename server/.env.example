# Copy to `.env` for local dev. On Render these are set by render.yaml / the
# dashboard, not this file.

# --- required ---
DATABASE_URL=postgresql://oworkly:oworkly_dev_pw@localhost:5433/oworkly_lms
JWT_SECRET=change-me-to-a-random-string-at-least-16-chars

# --- auth mode ---
# The app ships with a dev-login adapter only (no real OIDC yet). It is HARD
# DISABLED whenever NODE_ENV === "production", so a hosted demo must run with
# NODE_ENV=development (or "test") and DEV_AUTH_ENABLED=true. With dev-login on,
# anyone who has the URL can sign in as any seeded user — fine for a shared
# demo, not for anything real. Gate it at the edge (Cloudflare Access / basic
# auth) if that matters.
NODE_ENV=development
DEV_AUTH_ENABLED=true

# --- optional ---
# PORT is set automatically by Render; only needed locally. Defaults to 4000.
PORT=4000
# Only needed if the SPA is served from a DIFFERENT origin than the API. In the
# single-service Render deploy they share an origin, so this can stay unset.
CORS_ORIGINS=http://localhost:5173

# --- media storage (VIDEO / AUDIO / IMAGE question responses) ---
# Unset -> `local` driver: files are written under STORAGE_LOCAL_DIR and served
# back by the API itself. Fine for local dev and CI; not persistent on a
# typical PaaS disk. For a real bucket (Cloudflare R2 or any S3-compatible):
#   STORAGE_DRIVER=s3
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_BUCKET=oworkly-evidence
#   STORAGE_ACCESS_KEY=...
#   STORAGE_SECRET_KEY=...
#   STORAGE_REGION=auto
# STORAGE_LOCAL_DIR=/tmp/oworkly-evidence
# MAX_UPLOAD_BYTES=26214400

# --- not used in this phase; leave unset ---
# REDIS_URL=
# AI_PROVIDER / OPENAI_API_KEY / ANTHROPIC_API_KEY =
