# Copy to .env (root) and/or server/.env. Never commit the real file — secrets
# in production are injected via Kubernetes Secrets / a cloud secrets manager
# (see README "Secret management"), not this file.

NODE_ENV=development
PORT=4000
DEPLOYMENT_MODE=standalone          # standalone | saas | on_prem
TENANT_ID=default

DATABASE_URL=postgresql://oworkly:oworkly_dev_pw@localhost:5433/oworkly_lms
REDIS_URL=redis://localhost:6380

# Dev-only JWT signing secret. MUST be replaced (32+ random bytes) before any
# real deployment, and DEV_AUTH_ENABLED must be false/unset once a real OIDC
# provider is wired — see README "Authentication".
JWT_SECRET=change-me-to-a-real-random-secret-before-any-real-deployment
JWT_ISSUER=oworkly-lms-dev
JWT_AUDIENCE=oworkly-lms-api
JWT_ACCESS_TTL_SECONDS=900
DEV_AUTH_ENABLED=true

# Real OIDC (unused until these are set — see middleware/authentication)
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=

PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# AI provider: "auto" picks OpenAI/Anthropic if a key below is set, else the
# local deterministic stub. Never required for the app to run.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Object storage: "local" writes under STORAGE_LOCAL_DIR (default/dev),
# "minio"/"s3" use the S3-compatible client against the given endpoint.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=oworkly-evidence
STORAGE_ACCESS_KEY=oworkly-minio
STORAGE_SECRET_KEY=oworkly-minio-secret
STORAGE_REGION=us-east-1
STORAGE_LOCAL_DIR=/tmp/oworkly-evidence

LOG_LEVEL=info
TELEMETRY_ENDPOINT=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_VERIFY_WINDOW_SECONDS=60
RATE_LIMIT_VERIFY_MAX=20

CERTIFICATE_DEFAULT_VALIDITY_MONTHS=24
MAX_UPLOAD_BYTES=26214400
